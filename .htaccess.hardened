# OPTIONAL hardened .htaccess. Not active: copy these rules into .htaccess only after testing.
# On one LiteSpeed host this exact file made every file in assets/ return 403 Forbidden, so the site lost its
# stylesheet and scripts. If that happens, restore the plain .htaccess. The cache block at the bottom is the
# most likely cause, so try the file without it first.
Options -Indexes
<FilesMatch "^(config\.php|check\.php|README\.md)$">
    Require all denied
</FilesMatch>

# Security headers for every response, including the static page and assets that PHP never touches.
# The Content-Security-Policy matches common_headers() in includes/app.php. Where PHP sends the same header
# too, the value is identical, so browsers see no conflict.
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "no-referrer"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    Header always set Permissions-Policy "accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Cross-Origin-Embedder-Policy "require-corp"
    Header always set Cross-Origin-Resource-Policy "same-origin"
    # One year, this host name only. Leave out includeSubDomains and preload: other subdomains of the same
    # domain may not serve HTTPS.
    Header always set Strict-Transport-Security "max-age=31536000"
    # Feed readers that run in a browser need to fetch the RSS feed from another site.
    <Files "feed.php">
        Header always set Cross-Origin-Resource-Policy "cross-origin"
    </Files>
</IfModule>

# Stylesheets and scripts are loaded with a ?v= version in the page address, so they can be cached for 30 days.
# When you change one of these files, change the ?v= value where the page loads it (index.html, submit.php, admin.php).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|png)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
